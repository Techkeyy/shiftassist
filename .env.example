# Model provider. ShiftAssist runs on DeepSeek through its OpenAI-compatible API.
# Any provider Agent-Native supports also works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AGENT_ENGINE=ai-sdk:openai
AGENT_ENGINE_PREFER_BYO_KEY=1

# Optional: assistant turns per account per day (default 40, 0 turns it off).
# SHIFTASSIST_DAILY_AGENT_TURNS=40

# Production only. Local development uses PGlite and needs neither.
# DATABASE_URL=
# BETTER_AUTH_SECRET=

# Custom health check message
PING_MESSAGE=pong
